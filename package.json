{
	"name": "generic-aes70",
	"version": "0.3.3",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"license": "GPL-2.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-generic-aes70.git"
	},
	"engines": {
		"node": "^26.7",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"aes70": "^2.0.19",
		"es-toolkit": "^1.51.0",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.2",
		"@types/node": "^26.4.0",
		"@types/ws": "^8.18.1",
		"eslint": "^10.9.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0"
}
